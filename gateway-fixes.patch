+                }
+                
+                showStatus('Depositing USDC to Gateway Wallet... Please confirm in MetaMask', 'pending');
+                
+                // Convert amount to USDC units (6 decimals)
+                const amountUnits = ethers.utils.parseUnits(amount, 6);
+                
+                console.log('Deposit parameters:', {
