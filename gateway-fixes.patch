+                        showStatus('Please add Sepolia network to MetaMask', 'error');
+                        return;
+                    }
+                    throw switchError;
+                }
+                
+                // Connect wallet
+                const accounts = await window.ethereum.request({
+                    method: 'eth_requestAccounts'
+                });
+                
+                userAddress = accounts[0];
+                document.getElementById('userAddress').textContent = userAddress;
+                
+                // Setup ethers
+                provider = new ethers.providers.Web3Provider(window.ethereum);
+                signer = provider.getSigner();
+                
+                // Setup contracts
+                usdcContract = new ethers.Contract(USDC_CONTRACT, USDC_ABI, signer);
+                gatewayWalletContract = new ethers.Contract(GATEWAY_WALLET, GATEWAY_WALLET_ABI, signer);
+                
+                // Update UI
+                document.getElementById('connectBtn').style.display = 'none';
+                document.getElementById('approveBtn').style.display = 'block';
+                document.getElementById('depositBtn').style.display = 'block';
