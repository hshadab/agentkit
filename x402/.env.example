# Copy to .env and fill in secrets as needed

# ----- Network -----
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
EXPLORER_BASE_URL=https://sepolia.basescan.org

# ----- Wallets (DO NOT USE IN PROD) -----
# Private key that pays gas for on-chain execution (Base Sepolia)
#BASE_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Optional alias used by some helpers
#PRIVATE_KEY=${BASE_PRIVATE_KEY}

# Address used as attester when using EIP-712 attestation (derived from X402_ATTEST_PRIVATE_KEY)
#X402_ATTEST_SIGNER=0xYourAddress

# ----- x402 Payment Settings -----
X402_NETWORK=base-sepolia
# Base Sepolia USDC
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Recipient address for payments
X402_PAYTO=0x1111111111111111111111111111111111111111
X402_PRICE=$0.01
X402_ZKML_PORT=8610

# Optional: Facilitator URL
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional: Merchant identifier (bound into attestations)
X402_MERCHANT_ID=demo-merchant

# ----- zkML / On-chain Verification -----
# Enable on-chain Groth16 verification (requires funded wallet)
X402_ZKML_VERIFY_ETH=false
X402_ETH_VERIFY_MODE=backend

# Deployed verifier contract (Base Sepolia)
ZKML_VERIFIER_ADDRESS=0x6121Fd93594C316B78e74B91B89A06d3Bb682a8F
# Optional: path to deployment JSON with ABI
#ZKML_VERIFIER_DEPLOYMENT=./deployments/jolt-storage-verifier-base-sepolia.json

# ----- Attestation Config -----
# Use HMAC by default; set to true only if you also provide X402_ATTEST_PRIVATE_KEY
X402_ATTEST_EIP712=false
# Private key for EIP-712 attestation (if enabled)
#X402_ATTEST_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Domain options for EIP-712 (optional)
X402_ATTEST_DOMAIN_NAME=AgentKit x402 Attestation
X402_ATTEST_DOMAIN_VERSION=1
X402_ATTEST_CONTRACT=0x0000000000000000000000000000000000000000

# HMAC secret for attestations (dev default should be overridden)
X402_ZKML_ATTEST_SECRET=change-me-dev-secret

# ----- Fallback x402 HMAC headers -----
X402_SHARED_SECRET=demo-x402-secret
X402_REPLAY_WINDOW_MS=300000
X402_ALLOWED_SKEW_MS=30000

# ----- Agent (payer) key for headless x402 (no MetaMask) -----
# If set, /ui/pay-auto will create a real EIP-3009 authorization signed by this key
# and the server (executor) will call transferWithAuthorization on-chain.
X402_AGENT_PRIVATE_KEY=

# ----- Auto-pay mode (server-side) -----
# '' (off) | 'attest' (pay immediately after attestation) | 'anchor_confirmed' (pay after on-chain anchor confirms)
X402_AUTOPAY=

# ----- Policy -----
X402_ZKML_DECISION_THRESHOLD=80

# ----- Optional service URLs -----
UNIFIED_BACKEND=http://127.0.0.1:8002   # UI calls /ui/zkml/* which proxy to this backend

# ----- UI Demo Modes -----
# X402_AUTOPAY options:
#   '' (off)              → Use MetaMask flow from UI
#   'attest'              → Server pays immediately after attestation (no anchor required)
#   'anchor_confirmed'    → Server pays after on-chain anchor confirms (requires X402_ZKML_VERIFY_ETH=true)
