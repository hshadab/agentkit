+"use client";
+
+import { useMemo, useState } from "react";
+import { useAccount, useSignTypedData, useWalletClient } from "wagmi";
+
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+import { CopyCode } from "@/components/ui/copy-code";
+
+import {
+  buildAuthorization,
+  buildPaymentHeaderJson,
+  decodePaymentHeader,
+  encodePaymentHeader,
+  parseDecimalToUnits,
+  signAuthorization,
+  type X402PaymentHeader,
+} from "@/lib/x402/payment";
+
+const DEFAULTS = {
+  network: "base-sepolia",
+  chainId: 84532,
+  asset: "0x036CbD53842c5426634e7929541eC2318f3dCF7e" as const, // USDC Base Sepolia
+  payTo: "0x2e408ad62e30146404F4ED8A61253212f3f9A490" as const,
+  amountDecimal: "0.01",
+};
+
+export default function ToolsPage() {
+  const { address } = useAccount();
+  const { data: walletClient } = useWalletClient();
+  const { signTypedDataAsync } = useSignTypedData();
+
+  const [network, setNetwork] = useState<string>(DEFAULTS.network);
+  const [chainId, setChainId] = useState<number>(DEFAULTS.chainId);
+  const [asset, setAsset] = useState<string>(DEFAULTS.asset);
+  const [payTo, setPayTo] = useState<string>(DEFAULTS.payTo);
+  const [amountDecimal, setAmountDecimal] = useState<string>(DEFAULTS.amountDecimal);
+  const [validity, setValidity] = useState<number>(3600);
+  const [quoteId, setQuoteId] = useState<string>("");
+
+  const [header, setHeader] = useState<string>("");
+  const [headerJson, setHeaderJson] = useState<X402PaymentHeader | null>(null);
+  const [error, setError] = useState<string>("");
+
+  const canGenerate = useMemo(() => !!address && !!walletClient, [address, walletClient]);
+
+  const onGenerate = async () => {
+    setError("");
+    try {
+      if (!address || !walletClient) throw new Error("Connect your wallet first");
+
+      const value = parseDecimalToUnits(amountDecimal, 6); // USDC has 6 decimals
+
+      const authorization = buildAuthorization({
+        from: address as `0x${string}`,
+        to: payTo as `0x${string}`,
+        value,
+        validityWindowSeconds: validity,
+      });
+
+      const signature = await signAuthorization({
+        signTypedData: async p =>
+          signTypedDataAsync({
+            account: p.account,
+            domain: p.domain,
+            types: p.types as any,
+            primaryType: p.primaryType as any,
+            message: p.message as any,
+          }),
+        account: address as `0x${string}`,
+        asset: asset as `0x${string}`,
+        chainId,
+        authorization,
+      });
+
+      const json = buildPaymentHeaderJson({
+        network,
+        authorization,
+        signature,
+        quoteId: quoteId || undefined,
+      });
+      const encoded = encodePaymentHeader(json);
+      setHeader(encoded);
+      setHeaderJson(json);
+    } catch (e: any) {
+      setError(e?.message ?? String(e));
+    }
+  };
+
+  const [inspectInput, setInspectInput] = useState<string>("");
+  const [inspectResult, setInspectResult] = useState<X402PaymentHeader | null>(null);
+  const [inspectError, setInspectError] = useState<string>("");
+
+  const onInspect = () => {
+    setInspectError("");
+    try {
+      const json = decodePaymentHeader(inspectInput.trim());
+      setInspectResult(json);
+    } catch (e: any) {
+      setInspectError(e?.message ?? String(e));
+      setInspectResult(null);
+    }
+  };
+
+  return (
+    <div className="container mx-auto px-2 md:px-6 max-w-5xl">
+      <div className="grid gap-6 md:grid-cols-2">
+        <Card>
+          <CardHeader>
+            <CardTitle>Payment Header Builder</CardTitle>
+          </CardHeader>
+          <CardContent className="space-y-3">
+            <div className="grid grid-cols-2 gap-3">
+              <div>
+                <Label htmlFor="network">Network</Label>
+                <Input
+                  id="network"
+                  value={network}
+                  onChange={e => setNetwork(e.target.value)}
+                  placeholder="base | base-sepolia"
+                />
+              </div>
+              <div>
+                <Label htmlFor="chainId">Chain ID</Label>
+                <Input
+                  id="chainId"
+                  type="number"
+                  value={chainId}
+                  onChange={e => setChainId(parseInt(e.target.value || "0", 10))}
+                />
+              </div>
+            </div>
+            <div className="grid grid-cols-2 gap-3">
+              <div>
+                <Label htmlFor="asset">Asset (USDC)</Label>
+                <Input
+                  id="asset"
+                  value={asset}
+                  onChange={e => setAsset(e.target.value)}
+                  placeholder="USDC contract address"
+                />
+              </div>
+              <div>
+                <Label htmlFor="payTo">Pay To</Label>
+                <Input
+                  id="payTo"
+                  value={payTo}
+                  onChange={e => setPayTo(e.target.value)}
+                  placeholder="Recipient address"
+                />
+              </div>
+            </div>
+            <div className="grid grid-cols-2 gap-3">
+              <div>
+                <Label htmlFor="amount">Amount (USDC)</Label>
+                <Input
+                  id="amount"
+                  value={amountDecimal}
+                  onChange={e => setAmountDecimal(e.target.value)}
+                  placeholder="0.01"
+                />
+              </div>
+              <div>
+                <Label htmlFor="validity">Validity (s)</Label>
+                <Input
+                  id="validity"
+                  type="number"
+                  value={validity}
+                  onChange={e => setValidity(parseInt(e.target.value || "0", 10))}
+                />
+              </div>
+            </div>
+            <div>
+              <Label htmlFor="quoteId">Quote ID (optional)</Label>
+              <Input
+                id="quoteId"
+                value={quoteId}
+                onChange={e => setQuoteId(e.target.value)}
+                placeholder="Optional quoteId for idempotency"
+              />
+            </div>
+            <div className="flex gap-2 items-center">
+              <Button onClick={onGenerate} disabled={!canGenerate}>
+                {canGenerate ? "Generate Header" : "Connect Wallet"}
+              </Button>
+              {error && <span className="text-destructive text-sm">{error}</span>}
+            </div>
+            {header && (
+              <div className="space-y-2">
+                <Label>Encoded X-PAYMENT</Label>
+                <CopyCode code={header} toastMessage="Header copied" />
+                <Label>Decoded JSON</Label>
+                <CopyCode code={JSON.stringify(headerJson, null, 2)} toastMessage="JSON copied" />
+              </div>
+            )}
+          </CardContent>
+        </Card>
+
+        <Card>
+          <CardHeader>
+            <CardTitle>Payment Header Inspector</CardTitle>
+          </CardHeader>
+          <CardContent className="space-y-3">
+            <div>
+              <Label htmlFor="inspect">Paste X-PAYMENT header</Label>
+              <Input
+                id="inspect"
+                value={inspectInput}
+                onChange={e => setInspectInput(e.target.value)}
+                placeholder="Base64url-encoded header"
+              />
+            </div>
+            <div className="flex gap-2 items-center">
+              <Button variant="outline" onClick={onInspect}>
+                Decode
+              </Button>
+              {inspectError && (
+                <span className="text-destructive text-sm">{inspectError}</span>
+              )}
+            </div>
+            {inspectResult && (
+              <div className="space-y-2">
+                <Label>Decoded JSON</Label>
+                <CopyCode code={JSON.stringify(inspectResult, null, 2)} toastMessage="JSON copied" />
+              </div>
+            )}
+          </CardContent>
+        </Card>
+      </div>
+    </div>
+  );
+}
