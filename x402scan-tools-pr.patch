+import type { Address } from 'viem';
+
+// EIP-3009 TransferWithAuthorization payload
+export type TransferWithAuthorization = {
+  from: Address;
+  to: Address;
+  value: string; // uint256 as string
+  validAfter: string; // uint256 as string (unix seconds)
+  validBefore: string; // uint256 as string (unix seconds)
+  nonce: `0x${string}`; // bytes32
+};
+
+// Build an authorization with a validity window (in seconds)
+export const buildAuthorization = (params: {
+  from: Address;
+  to: Address;
+  value: bigint | string;
+  validityWindowSeconds?: number;
+}): TransferWithAuthorization => {
+  const now = Math.floor(Date.now() / 1000);
+  const validAfter = BigInt(now);
+  const validBefore = BigInt(now + (params.validityWindowSeconds ?? 3600));
+
+  // Random 32-byte nonce
+  const nonce =
+    (typeof crypto !== 'undefined' && 'getRandomValues' in crypto)
+      ? ((): `0x${string}` => {
+          const arr = new Uint8Array(32);
+          crypto.getRandomValues(arr);
+          return `0x${Array.from(arr)
+            .map(b => b.toString(16).padStart(2, '0'))
+            .join('')}` as const;
+        })()
+      : ((): `0x${string}` => {
+          // Fallback (Node env) — not used in client, but safe default
+          const bytes = Array.from({ length: 32 }, () =>
+            Math.floor(Math.random() * 256)
+          );
+          return `0x${bytes
+            .map(b => b.toString(16).padStart(2, '0'))
+            .join('')}` as const;
+        })();
+
+  const value = typeof params.value === 'bigint' ? params.value : BigInt(params.value);
+
+  return {
+    from: params.from,
+    to: params.to,
+    value: value.toString(),
+    validAfter: validAfter.toString(),
+    validBefore: validBefore.toString(),
+    nonce,
+  };
+};
+
+// viem/wagmi `signTypedData` compatible inputs
+type SignTypedData = (params: {
+  account: Address;
+  domain: {
+    name: string;
+    version: string;
+    chainId: number;
+    verifyingContract: Address;
+  };
+  types: Record<string, Array<{ name: string; type: string }>>;
+  primaryType: string;
+  message: TransferWithAuthorization;
+}) => Promise<`0x${string}`>;
+
+// Sign an EIP-3009 TransferWithAuthorization (USDC domain)
+export const signAuthorization = async (params: {
+  signTypedData: SignTypedData;
+  account: Address;
+  asset: Address;
+  chainId: number;
+  authorization: TransferWithAuthorization;
+}) => {
+  const domain = {
+    name: 'USDC',
+    version: '2',
+    chainId: params.chainId,
+    verifyingContract: params.asset,
+  } as const;
+
+  const types = {
+    TransferWithAuthorization: [
+      { name: 'from', type: 'address' },
+      { name: 'to', type: 'address' },
+      { name: 'value', type: 'uint256' },
+      { name: 'validAfter', type: 'uint256' },
+      { name: 'validBefore', type: 'uint256' },
+      { name: 'nonce', type: 'bytes32' },
+    ],
+  } as const;
+
+  return params.signTypedData({
+    account: params.account,
+    domain,
+    types,
+    primaryType: 'TransferWithAuthorization',
+    message: params.authorization,
+  });
+};
+
+export type X402PaymentHeader = {
+  x402Version: 1;
+  scheme: 'exact';
+  network: string; // e.g., 'base' | 'base-sepolia'
+  quoteId?: string;
+  payload: {
+    authorization: TransferWithAuthorization;
+    signature: `0x${string}`;
+  };
+};
+
+export const buildPaymentHeaderJson = (input: {
+  network: string;
+  authorization: TransferWithAuthorization;
+  signature: `0x${string}`;
+  quoteId?: string;
+}): X402PaymentHeader => ({
+  x402Version: 1,
+  scheme: 'exact',
+  network: input.network,
+  quoteId: input.quoteId,
+  payload: {
+    authorization: input.authorization,
+    signature: input.signature,
+  },
+});
+
+// Base64url utils (browser-friendly)
+const base64urlEncode = (str: string) => {
+  if (typeof window !== 'undefined' && typeof btoa === 'function') {
+    const b64 = btoa(unescape(encodeURIComponent(str)));
+    return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
+  }
+  // Node fallback
+  // eslint-disable-next-line @typescript-eslint/ban-ts-comment
+  // @ts-ignore
+  return Buffer.from(str).toString('base64url');
+};
+
+const base64urlDecode = (b64url: string) => {
+  const b64 = b64url.replace(/-/g, '+').replace(/_/g, '/');
+  const pad = b64.length % 4 === 0 ? '' : '='.repeat(4 - (b64.length % 4));
+  const final = b64 + pad;
+  if (typeof window !== 'undefined' && typeof atob === 'function') {
+    return decodeURIComponent(escape(atob(final)));
+  }
+  // Node fallback
+  // eslint-disable-next-line @typescript-eslint/ban-ts-comment
+  // @ts-ignore
+  return Buffer.from(final, 'base64').toString('utf8');
+};
+
+export const encodePaymentHeader = (json: X402PaymentHeader) => {
+  return base64urlEncode(JSON.stringify(json));
+};
+
+export const decodePaymentHeader = (header: string): X402PaymentHeader => {
+  const raw = base64urlDecode(header);
+  return JSON.parse(raw) as X402PaymentHeader;
+};
+
+export const parseDecimalToUnits = (value: string, decimals: number) => {
+  // Basic decimal parser: supports up to decimals precision
+  const [int, fracRaw = ''] = value.split('.');
+  const frac = (fracRaw + '0'.repeat(decimals)).slice(0, decimals);
+  const normalized = `${int}${frac}`.replace(/^0+/, '') || '0';
+  return BigInt(normalized);
+};
+
