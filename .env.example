# AI Services (REQUIRED - system won't work without this)
OPENAI_API_KEY=sk-your-actual-api-key-here

# Circle API (for USDC transfers)
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_ETH_WALLET_ID=your_ethereum_wallet_id
CIRCLE_SOL_WALLET_ID=your_solana_wallet_id

# zkEngine Path
ZKENGINE_BINARY=./zkengine_binary/zkEngine

# Optional: Custom ports
PORT=8001
CHAT_SERVICE_PORT=8002

# Avalanche deployment configuration
# To deploy to Avalanche Fuji testnet, you need to set your private key
# Export your MetaMask private key for the account that has test AVAX
# WARNING: Never commit your actual private key to version control!
AVALANCHE_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Your deployment address should be: 0xE616B2eC620621797030E0AB1BA38DA68D78351C
# Get test AVAX from: https://faucets.chain.link/fuji