# Copy this file to .env and fill in your values

# OpenAI API Key for LangChain integration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Change ports if needed
RUST_SERVER_PORT=8001
PYTHON_SERVICE_PORT=8002

# Unified server
UI_PORT=8000
IOTEX_PORT=8007
ZKML_PORT=8002
GROTH16_PORT=3004
GATEWAY_API=https://gateway-api-testnet.circle.com
ENABLED_PROBES=iotex
ENABLED_WORKFLOWS=iotex,gateway

# Private keys (set for real on-chain operations)
# NEVER commit real keys; configure in local .env only
IOTEX_PRIVATE_KEY=
GROTH16_PRIVATE_KEY=
PRIVATE_KEY=
