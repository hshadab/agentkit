SOL_RPC_URL=https://api.devnet.solana.com
BASE_NETWORK=sepolia
BASE_RPC_URL=https://sepolia.base.org

# Contract Addresses (Deployed)
# Ethereum Sepolia
ETH_VERIFIER_CONTRACT=0x1e8150050a7a4715aad42b905c08df76883f396f

# Solana Devnet
SOL_PROGRAM_ID=2qohsyvXBRZMVRbKX74xkM6oUfntBqGMB7Jdk15n8wn7

# Base Sepolia
BASE_ZK_VERIFIER_CONTRACT=0x74D68B2481d298F337e62efc50724CbBA68dCF8f
