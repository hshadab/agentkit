OPENAI_MODEL=gpt-4
COINBASE_API_KEY=30f1d73c-8bb7-42b6-8f5d-bb5b79b1dd4a

# Circle API Configuration
# Get your API key from https://app-sandbox.circle.com/
CIRCLE_API_KEY=SAND_API_KEY:your-api-key:your-secret
# Create wallets via: node circle/create-wallets-api.js
CIRCLE_ETH_WALLET_ID=your-ethereum-wallet-id
CIRCLE_SOL_WALLET_ID=your-solana-wallet-id
CIRCLE_USDC_TOKEN_ID=2552c76e-860a-47c8-a6d1-a20ba3e59334
CIRCLE_ENTITY_SECRET=c5729c5ef63ce6fbf04daa0eb7479403342a7d0ac123abb2fc9ba38969c692ac

# Circle Developer Wallet (UUID format)
