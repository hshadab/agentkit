# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
DEBUG_MODE=false

# Feature Flags
ENABLE_OPENAI=true
ENABLE_CIRCLE=true
ENABLE_SOLANA=true
ENABLE_ETHEREUM=true
ENABLE_BASE=true
ENABLE_DEBUG_PANEL=false

# Security Configuration
CORS_ORIGIN=*

# Development Options
MOCK_PROOFS=false
SKIP_BLOCKCHAIN=false