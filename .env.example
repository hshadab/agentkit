# Copy this file to .env and fill in your values

# OpenAI API (used directly by Rust backend for agentic parsing)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

RUST_SERVER_PORT=8001

# Upstream services (Rust proxies these routes to the services below)
ZKML_SERVICE_URL=http://localhost:8002
IOTEX_SERVICE_URL=http://localhost:8007
MEDICAL_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004

# Circle Gateway (called directly by Rust; no Node proxy needed)
CIRCLE_GATEWAY_API_BASE=https://gateway-api-testnet.circle.com
CIRCLE_GATEWAY_API_KEY=

ENABLED_PROBES=iotex
ENABLED_WORKFLOWS=iotex,gateway

# Private keys (set for real on-chain operations)
# NEVER commit real keys; configure in local .env only
IOTEX_PRIVATE_KEY=
GROTH16_PRIVATE_KEY=
PRIVATE_KEY=
ETH_RPC=https://eth-sepolia.public.blastapi.io

# Avalanche (Fuji)
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
AVALANCHE_PRIVATE_KEY=
# Deployed medical records contract
AVALANCHE_MEDICAL_CONTRACT=0x1698ebB10e789EebE7A66bDb096F0a65ce49Dc68

# Base (Sepolia)
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_PRIVATE_KEY=
# AI commitment contract
BASE_AI_COMMITMENT=0xae7d069d0A45a8Ecd969ABbb2705bA96472D36FC

# x402 proof-gated demo
X402_ZKML_ATTEST_SECRET=dev-attest-secret
X402_ZKML_ATTEST_TTL_MS=300000
X402_ZKML_PORT=8602
UNIFIED_BACKEND=http://127.0.0.1:8002
PROOF_GATE=http://127.0.0.1:8602
X402_SHARED_SECRET=demo-x402-secret
X402_REPLAY_WINDOW_MS=300000
X402_ALLOWED_SKEW_MS=30000
X402_PAYTO=0x1111111111111111111111111111111111111111
X402_NETWORK=base-sepolia
X402_PRICE=$0.01
X402_FACILITATOR_URL=https://x402.org/facilitator
