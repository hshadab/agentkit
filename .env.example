# Server Configuration
PORT=8001
HOST=localhost
WS_URL=ws://localhost:8001/ws
NODE_ENV=development
CHAT_SERVICE_PORT=8002
CHAT_SERVICE_URL=http://localhost:8002

# AI Services (REQUIRED - system won't work without this)
