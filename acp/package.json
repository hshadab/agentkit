    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "onnxruntime-node": "^1.16.3",
    "openai": "^5.23.2",
    "solc": "^0.8.21",
    "stripe": "^14.25.0",
    "uuid": "^9.0.1"
