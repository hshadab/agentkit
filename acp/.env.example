# Service Ports
PROOF_SERVICE_PORT=9001
ACP_SERVICE_PORT=9002
VERIFICATION_SERVICE_PORT=9003
ONCHAIN_VERIFICATION_PORT=9004
DEMO_UI_PORT=9000

# JOLT-Atlas Configuration (REAL zkML proof generation)
JOLT_BINARY_PATH=/home/hshadab/agentkit/jolt-atlas/target/release/llm_prover
JOLT_MODEL_PATH=/home/hshadab/agentkit/acp/models/authorization_model.onnx

# Stripe Configuration (REQUIRED for real payments)
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Base Sepolia Configuration (REQUIRED for on-chain verification)
# RPC URL (free public endpoint)
BASE_RPC_URL=https://sepolia.base.org
# Or use: https://base-sepolia.blockpi.network/v1/rpc/public

# Private key for deploying contracts and sending transactions
# IMPORTANT: Use a test wallet with Base Sepolia ETH
# Get test ETH from: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
BASE_PRIVATE_KEY=0x...
PRIVATE_KEY=0x...

# Verifier contract address (filled after deployment)
BASE_VERIFIER_ADDRESS=0x...

# Ethereum Sepolia (optional, for testing)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Security
JWT_SECRET=your-jwt-secret-here
API_KEY=your-api-key-here

# Logging
LOG_LEVEL=info
ENABLE_DEBUG=false